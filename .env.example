# =============================================================================
# RailGate — Railway Personal Gateway
# Example environment configuration.
#
# On Railway you do NOT upload this file. You create these as service
# Variables:  Railway -> your service -> Variables -> New Variable.
#
# Locally (docker compose) copy this file to `.env` and fill it in:
#     cp .env.example .env
#
# Legend:
#   [REQUIRED]  you must set this yourself
#   [OPTIONAL]  has a safe default
#   [AUTO]      injected by Railway automatically — do NOT set by hand
# =============================================================================


# -----------------------------------------------------------------------------
# ADMIN PANEL AUTHENTICATION
# -----------------------------------------------------------------------------

# [OPTIONAL] Username for the web dashboard and API. Default: admin
ADMIN_USERNAME=admin

# [REQUIRED] Password for the web dashboard.
# There is deliberately NO default. When APP_ENV=production and this is empty
# the container refuses to start with a clear error message (fail closed).
# Generate a strong value, e.g.:
#     openssl rand -base64 24
#     python3 -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=

# [OPTIONAL but strongly recommended] Secret used to derive session tokens.
# If empty, a random one is generated at boot — everyone gets logged out on
# every redeploy/restart. Set it once to keep sessions stable.
#     openssl rand -hex 32
ADMIN_SESSION_SECRET=

# [OPTIONAL] How long a dashboard login stays valid, in hours. Default: 12
ADMIN_SESSION_TTL_HOURS=12

# [OPTIONAL] Login brute-force protection: max failed attempts per IP inside
# the window before that IP is temporarily locked out. Defaults: 8 / 300s.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900


# -----------------------------------------------------------------------------
# NETWORK PORTS
# -----------------------------------------------------------------------------

# [AUTO] HTTP port for the admin dashboard/API. Railway injects PORT.
# The app binds 0.0.0.0:$PORT. Only override locally. Default: 8080
# PORT=8080

# [OPTIONAL] Internal TCP port that Xray (VLESS + REALITY) listens on.
# This is the port you point Railway's TCP Proxy at.
# It is NOT the public port — Railway assigns a random public port.
XRAY_PORT=2443

# [OPTIONAL] Internal-only loopback port for the WebSocket fallback backend.
# Never exposed publicly; the admin app proxies to it. Default: 2444
XRAY_WS_BACKEND_PORT=2444

# [OPTIONAL] Internal-only loopback port for Xray's gRPC management API,
# used to add/remove users without restarting Xray. Bound to 127.0.0.1 only.
XRAY_API_PORT=10085


# -----------------------------------------------------------------------------
# PERSISTENCE
# -----------------------------------------------------------------------------

# [OPTIONAL] Directory for the SQLite DB, REALITY keys, generated config,
# backups and logs. On Railway, mount a Volume here. Default: /data
DATA_DIR=/data


# -----------------------------------------------------------------------------
# PUBLIC VPN ENDPOINT (what goes into the client link)
# -----------------------------------------------------------------------------
# Normally you set NOTHING here. Once you add a TCP Proxy in Railway, these are
# derived automatically from RAILWAY_TCP_PROXY_DOMAIN / RAILWAY_TCP_PROXY_PORT.
#
# Use these manual overrides only if Railway's variables are unavailable, or if
# you front the service with your own domain.

# [OPTIONAL] Overrides RAILWAY_TCP_PROXY_DOMAIN, e.g. gateway.example.com
PUBLIC_PROXY_HOST=

# [OPTIONAL] Overrides RAILWAY_TCP_PROXY_PORT, e.g. 18423
PUBLIC_PROXY_PORT=


# -----------------------------------------------------------------------------
# REALITY (primary transport: VLESS + XTLS Vision + REALITY over raw TCP)
# -----------------------------------------------------------------------------

# [REQUIRED-ish] The domain your traffic is camouflaged as (client SNI).
# It must be a real, external, third-party HTTPS site that:
#   * supports TLS 1.3 + X25519 + HTTP/2
#   * is NOT behind Cloudflare/your own infra
#   * is reachable from Railway's region
#   * is not blocked where your phone is
# Default if unset: www.microsoft.com
REALITY_SERVER_NAME=www.microsoft.com

# [REQUIRED-ish] host:port Xray forwards non-VPN probes to. Must match
# REALITY_SERVER_NAME (same site) and normally uses port 443.
# Default if unset: www.microsoft.com:443
REALITY_DESTINATION=www.microsoft.com:443

# [OPTIONAL] TLS fingerprint the client mimics: chrome, firefox, safari,
# ios, android, edge, random, randomized. Default: chrome
REALITY_FINGERPRINT=chrome

# [OPTIONAL] Client "spiderX" value embedded in the share link. Default: /
REALITY_SPIDER_X=/


# -----------------------------------------------------------------------------
# WEBSOCKET FALLBACK (secondary transport over Railway's HTTPS domain)
# -----------------------------------------------------------------------------

# [OPTIONAL] Enable the VLESS-over-WebSocket fallback that rides Railway's
# normal public HTTPS domain (port 443). Useful before you configure the TCP
# Proxy, or when raw TCP is blocked. Default: true
ENABLE_WS_FALLBACK=true

# [OPTIONAL] Path for the fallback. Leave empty to auto-generate a random,
# unguessable path on first boot (recommended) and persist it in the DB.
# Example of an explicit value: /gateway/8f3c1d2a9b7e
WS_FALLBACK_PATH=


# -----------------------------------------------------------------------------
# ACCOUNT DEFAULTS
# -----------------------------------------------------------------------------

# [OPTIONAL] Default account lifetime in days when you don't pass one.
# 0 = never expires. Default: 0
VPN_DEFAULT_EXPIRY_DAYS=0

# [OPTIONAL] How often (seconds) the expiry sweeper runs. Default: 60
EXPIRY_CHECK_INTERVAL=60


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# [OPTIONAL] Shown in the dashboard header and in client link names.
APP_NAME=Railway Personal Gateway

# [OPTIONAL] production | development
# production  -> ADMIN_PASSWORD mandatory, Secure cookies, HSTS
# development -> bootstrap password auto-generated and printed once
APP_ENV=production

# [OPTIONAL] DEBUG | INFO | WARNING | ERROR. Default: INFO
LOG_LEVEL=INFO

# [OPTIONAL] Xray log verbosity: debug|info|warning|error|none. Default: warning
XRAY_LOG_LEVEL=warning


# -----------------------------------------------------------------------------
# CLIENT COMPATIBILITY
# -----------------------------------------------------------------------------

# [OPTIONAL] Value used for `type=` in generated VLESS links.
#   tcp  -> maximum compatibility, understood by every client (default)
#   raw  -> the modern Xray name; use only if your client is recent
URI_NETWORK_ALIAS=tcp


# -----------------------------------------------------------------------------
# SECURITY / ROUTING
# -----------------------------------------------------------------------------

# [OPTIONAL] Block BitTorrent through the gateway. Default: true
BLOCK_BITTORRENT=true

# [OPTIONAL] Endpoint used to display the container's outbound public IP.
# Called with a short timeout and cached; failure never affects health.
OUTBOUND_IP_CHECK_URL=https://api.ipify.org

# [OPTIONAL] Set to false to never call the outbound IP service. Default: true
OUTBOUND_IP_CHECK_ENABLED=true


# =============================================================================
# [AUTO] Injected by Railway — listed for reference only. DO NOT set these.
# =============================================================================
# RAILWAY_PUBLIC_DOMAIN            e.g. railgate-production.up.railway.app
# RAILWAY_PRIVATE_DOMAIN           e.g. railgate.railway.internal
# RAILWAY_TCP_PROXY_DOMAIN         e.g. metro.proxy.rlwy.net
# RAILWAY_TCP_PROXY_PORT           e.g. 18423  (public port — random!)
# RAILWAY_TCP_APPLICATION_PORT     e.g. 2443   (internal target port)
# RAILWAY_SERVICE_NAME
# RAILWAY_PROJECT_NAME
# RAILWAY_ENVIRONMENT_NAME
# RAILWAY_REPLICA_REGION
# RAILWAY_DEPLOYMENT_ID
